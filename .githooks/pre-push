#!/bin/sh
# Gate pre-push de transcribe-cli: corre los tests rápidos (CLI + UI del desktop) y
# el build del desktop antes de dejar pushear. Si algo falla, el push se bloquea.
#
# Activar en un clone nuevo (una sola vez):   git config core.hooksPath .githooks
# Bypass de emergencia (saltar el gate):       git push --no-verify
#
# No corre los tests de Rust (cargo test) a propósito: la primera compilación es
# lenta y necesita CARGO_TARGET_DIR fuera de ~/Desktop (iCloud). Correlos a mano:
#   export CARGO_TARGET_DIR=$HOME/.cache/cargo-target/transcribe-desktop
#   (cd desktop/src-tauri && cargo test)
set -e

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

if ! command -v bun >/dev/null 2>&1; then
  echo "✗ pre-push: no encuentro 'bun' en el PATH." >&2
  echo "  Instalalo o, para saltar el gate esta vez: git push --no-verify" >&2
  exit 1
fi

echo "▶ pre-push (1/3): tests del CLI…"
bun test ./src

echo "▶ pre-push (2/3): tests de UI del desktop…"
(cd desktop && bun test)

echo "▶ pre-push (3/3): build del desktop…"
(cd desktop && bun run build)

echo "✓ pre-push: todo verde — pusheando"
